PORT=3000
DB_PATH=./data/crm.sqlite
APP_ORIGIN=https://your-public-app.example
# OAuth applications per CRM. Leave a pair empty to show that CRM as "not configured" in the admin UI.
BITRIX_CLIENT_ID=your-bitrix-app-id
BITRIX_CLIENT_SECRET=your-bitrix-app-secret
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
ADMIN_API_KEY=generate-a-long-random-admin-key
DATA_KEY_BASE64=base64-encoded-32-random-bytes
# Optional: where the OAuth callback sends the browser back (Vite dev server, e.g. http://localhost:5173).
# Defaults to APP_ORIGIN, which serves the built admin UI from apps/web/dist.
ADMIN_ORIGIN=
